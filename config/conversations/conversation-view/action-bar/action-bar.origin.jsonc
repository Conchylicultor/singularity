{
  // Item: "<key>" (terse; <key> is "<pluginId>:<id>")
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  // Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
  "items": [
    "apps.agent-manager.pages-nav:pages",
    "code-explorer:explorer",
    "conversations.conversation-view.artifacts:artifacts",
    "conversations.conversation-view.commits-graph:commits-graph",
    "conversations.conversation-view.jsonl-viewer.event-counter:event-counter",
    "conversations.conversation-view.open-app:open-app",
    "conversations.conversation-view.push-profiling:push-profiling",
    "conversations.conversation-view.tasks-panel:tasks",
    "conversations.conversation-view.terminal-pane:terminal",
    "conversations.conversation-view.vscode:vscode",
    "review:review",
    "tasks.attempt-view:attempt-switch"
  ]
}
