  "defaultModel": "opus",
  "visibleModels": {
    "fable": true,
    "opus": true,
    "sonnet": true,
    "fable-5-1": false,
    "fable-5": false,
    "opus-5-5": false,
    "opus-5": false,
    "opus-4-8": false,
    "opus-4-7": false,
    "opus-4-6": false,
    "sonnet-5": false,
    "sonnet-4-6": false
  }
}
