  // Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
  "items": [
    "backup.runs-arm:archive",
    "backup.runs-arm:sources",
    "backup.runs-arm:targets"
  ]
