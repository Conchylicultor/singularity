// @hash 927627d99c63
// `task-dependencies` merged its two sections into one: `dependents` is gone and
// `dependencies` now renders both ends of the edge, in the position the pair held.
// `task-events` split into two sections (its one card nested two titled blocks,
// which the host's own title would have made a third). Both halves take the
// position the old combined `events` entry held, pushes before attempts — the
// order they were stacked in inside the old card. Every other entry is the
// hand-authored arrangement and is untouched.
{
  // Hide: { "item": "<key>", "hidden": true }. Gap: { "type": "spacer", "id": "<unique-id>" }.
  "items": [
    "tasks.task-deps-tree:deps-tree",
    "tasks.task-header:header",
    "tasks.task-description:description",
    "apps.pages.prompt-origin:prompt-origin",
    "tasks.task-dependencies:dependencies",
    "tasks.task-events:pushes",
    "tasks.task-events:attempts",
    "tasks.task-attachments:attachments",
    "tasks.task-preprompt:preprompt",
    "tasks.task-effort:effort",
    "tasks.task-graph:graph"
  ]
}
