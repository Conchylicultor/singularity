// @hash aea893639ee7
// Launch options of the Prompt card: a vertical stack of label + control rows,
// read top-down, ordered as the launch itself resolves them — WHETHER it starts
// (auto-start model), WHAT is prepended to the first turn (preprompt), then HOW
// hard it thinks (thinking mode).
// Node forms: "pluginId:id" (an item, terse) |
// { "item": "pluginId:id", "hidden": true } (drop it from the slot) |
// { "type": "spacer", "id": "<unique-id>" } (a blank gap).
// At most one spacer per slot.
{
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  "items": [
    "tasks.auto-start:auto-start",
    "tasks.task-preprompt:preprompt",
    "tasks.task-effort:effort"
  ]
}
