// @hash 76610db59d8c
{
  // Off, it files nothing.
  "enabled": false,
  // What the agent may do with its finished work: never push, push only an uncontroversial change, or push once checks pass.
  // Allowed values: "never", "safe", "checks"
  "push": "safe",
  // The model every agent this automation launches runs with.
  "model": "opus",
  // The sources that do not take part.
  "excludedSources": [],
  // Run on a schedule, or when its event fires.
  // Allowed values: "schedule", "event"
  "trigger": "event",
  // hour, day (at), days (every N days at), week (weekday at), or cron.
  // Allowed values: "hour", "day", "days", "week", "cron"
  "cadence": "day",
  // Local time, HH:MM.
  "at": "06:00",
  "everyDays": 2,
  // Allowed values: "mon", "tue", "wed", "thu", "fri", "sat", "sun"
  "weekday": "mon",
  // 5-field crontab in UTC (m h dom mon dow), for the cron schedule.
  "cron": "0 6 * * *",
  // An event-triggered run starts this long after the last event of a burst — at most 6× it after the first.
  "settleMinutes": 2,
  // What the agent is told: the filed task's description, or the first prompt of an agent it launches on an existing task. {{variable}} placeholders are filled per task; {{pushPolicy}} says what the Push setting allows.
  "prompt": "You are working through the sidequest backlog on autopilot. Nobody is watching this conversation: the person reads your report when they are back. Your task (`{{taskId}}`):\n\n# {{title}}\n\n{{description}}\n\n## How to work\n\n- **Never ask questions, and never wait for an answer.** Nobody will reply. Where you would ask, make the cleanest call and record it in your report — or, if the call is the person's to make, stop and put it to them as your report's decision question.\n- **First check the task is still worth doing.** Search the code and git history: it may already be fixed, or the code it names may be gone. If it is obsolete, change nothing — say why in your report and ask whether to drop it.\n- **Stay in scope.** Do what this task asks, nothing more. Anything else you notice: file it with the `add_task` MCP tool on the `sidequest` track, and move on.\n- **Stop early** when the task turns out much bigger than its description suggests, or needs a design choice that is not yours to make: write up what you found and what the options are, and stop there.\n- **Never touch database migrations, auth, or the gateway** without leaving the push to the person, whatever the push setting below says.\n- Build with `./singularity build` and make sure it is `ok`.\n\n## Pushing\n\n{{pushPolicy}}\n\n## When you are done\n\nFinish by calling the `submit_outcome_report` MCP tool **exactly once**, then stop — do NOT call `exit_clean`: the conversation stays open so the person can read your report and answer it. Write the report for someone who has no context on this code:\n\n1. **The problem and why we care** — what was wrong, and what it cost.\n2. **The mental model, before → after** — how this part worked before and how it works now.\n3. **What changed** — the files and behaviour, briefly, and whether you pushed.\n4. **Caveats** — anything you encountered, skipped or are unsure of.\n5. **One decision question**, only if there is one — the single thing you need the person to decide.",
  // How many of its agents may run at the same time. The next one starts when one finishes or reports.
  "concurrency": 2,
  // When it turns itself off: an ISO datetime, or "" to run until you turn it off. Agents already running finish either way.
  "runUntil": ""
}
