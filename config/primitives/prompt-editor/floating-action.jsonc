// @hash 3a0216538445
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // A horizontal strip, read left → right. The template chips are the one
  // filling cell, so they hold the row's slack and everything after them is
  // pinned to the right edge: the exit menu, Push & Exit, and the mic last.
  "items": [
    "conversations.conversation-view.prompt-templates:prompt-templates",
    "conversations.conversation-view.exit-menu:exit-menu",
    "conversations.conversation-view.push-and-exit:push-and-exit",
    "primitives.prompt-editor.voice-input:voice-input"
  ]
}
