// @hash 2e5ea0b3f7d0
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  // The shared site header — ONE row worn by the two question pages (the homepage
  // deliberately wears none), read left to right: the wordmark is the brand and
  // stays at the leading edge, then the pane's own title item (these panes set no
  // title, so it paints nothing and simply holds the slack).
  //
  // After the spacer, the two questions in the order the homepage forks them:
  // the applications first, the engineering second.
  "items": [
    "apps.website.shell:wordmark",
    "primitives.pane:title",
    { "type": "spacer", "id": "spacer-1" },
    "apps.website.questions.apps:apps",
    "apps.website.questions.harness:harness"
  ]
}
