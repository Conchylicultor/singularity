// @hash 4595f664dcb3
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  // The shared site header — ONE row worn by every page, read left to right: the
  // wordmark is the brand and stays at the leading edge, then the pane's own
  // title item (these panes set no title, so it paints nothing and simply holds
  // the slack).
  //
  // After the spacer, the site's pages — Vision, Foundations, Story, then the
  // Guide and Download for a reader ready to run it — then the source on
  // GitHub, the one destination that leaves the site, and last the header's one
  // call to action: Improve, which lets the reader try the gesture the site is
  // about.
  "items": [
    "apps.website.shell:wordmark",
    "primitives.pane:title",
    { "type": "spacer", "id": "spacer-1" },
    "apps.website.pages.apps:apps",
    "apps.website.pages.foundations:foundations",
    "apps.website.pages.story:story",
    "apps.website.pages.guide:guide",
    "apps.website.pages.download:download",
    "apps.website.shell:github",
    "apps.website.improve:improve"
  ]
}
