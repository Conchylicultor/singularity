// @hash 1e879662063a
// A horizontal pane header, read left to right. The pane's own title comes
// first, then `view-mode` — Focus or Compare is a choice about the prototype
// itself, so it leads, beside the title. (It used to sit there because it was
// contributed with `position: "left"`; there is no such field any more, and its
// place in this list is now the whole of the decision.)
//
// After the spacer, `present` and `improve` share the trailing cluster, and
// their order there is the real decision. `present` goes first: it is what this
// pane is FOR — viewing the prototype without the app around it — whereas
// `improve` is the app-wide feedback affordance that appears on many surfaces.
// The specific action sits nearer the content, the generic utility outboard of
// it. (The seeded order had these reversed, purely because it followed
// contribution registration order.)
//
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  "items": [
    "primitives.pane:title",
    "apps.prototypes.gallery:view-mode",
    { "type": "spacer", "id": "spacer-1" },
    "apps.prototypes.present:present",
    "apps.prototypes.gallery:improve"
  ]
}
