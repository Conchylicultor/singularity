// @hash 6ec84829688d
{
  // The Places sidebar (places/web/components/places-sidebar.tsx), rendered
  // with the DataView `sections` chrome: each view below is a section under
  // its own header, in this order. Both are lists of the contributed places,
  // partitioned by their `group` (favorites / locations); `visibleFields`
  // keeps `group` a filter dimension only, so a row is just its icon and name.
  "views": [
    {
      "id": "favorites",
      "name": "Favorites",
      "icon": "star",
      "view": {
        "type": "list",
        "visibleFields": ["label"],
        "filter": {
          "kind": "group",
          "id": "favorites",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "favorites-group",
              "fieldId": "group",
              "operatorId": "is",
              "value": "favorites"
            }
          ]
        }
      }
    },
    {
      "id": "locations",
      "name": "Locations",
      "icon": "hard-drive",
      "view": {
        "type": "list",
        "visibleFields": ["label"],
        "filter": {
          "kind": "group",
          "id": "locations",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "locations-group",
              "fieldId": "group",
              "operatorId": "is",
              "value": "locations"
            }
          ]
        }
      }
    }
  ],
  "sortPresets": [],
  "filterPresets": [],
  "customColumns": []
}
