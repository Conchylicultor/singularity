// @hash 281df19547e5
{
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  //
  // A hover-revealed row cluster, read left to right, ordered by how much each
  // action changes. `open` only looks — it opens the page the source stands for
  // — so it leads. Delete stays last by convention: the rightmost button is
  // where the user's muscle memory puts the destructive one, so the reversible
  // enable/disable toggle lands ahead of it.
  "items": [
    "apps.events.sources:open",
    "apps.events.sources:enabled",
    "apps.events.sources:delete"
  ]
}
