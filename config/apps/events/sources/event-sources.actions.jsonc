// @hash 5f2723af2af7
// The Sources pane header: the pane's own title, then a horizontal strip of
// icon buttons at the trailing edge. "Refresh all" is the only action here and
// is a set operation over the whole list — per-source actions live on the rows
// themselves (events.sources.item-actions), not up here. One action, so there
// is no spacer: the title's cell already holds the row's slack, which packs the
// action against the trailing edge.
//
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  "items": [
    "primitives.pane:title",
    "apps.events.sources.refresh-all:refresh-all"
  ]
}
