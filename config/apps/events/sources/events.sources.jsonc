// @hash 6ec84829688d
{
  // The first row is the landing view. A source list is read as "is everything
  // working" before "what have I got", so `All` leads (every source, newest
  // first is already the resource's own order) and `Needs attention` is the
  // one-click answer to the only urgent question. `By type` is the same set
  // partitioned by kind — useful once several source types are installed, and
  // it names none of them: the sections come from the live registry.
  //
  // `Needs attention` filters on `extraction` (the derived last-extraction
  // status), NOT on `status`. `status` is what the source is doing right now,
  // and its `error` value only ever holds a TERMINAL failure — so a source
  // whose runs keep failing transiently, and a source that succeeds every run
  // while finding zero events (a site that changed its markup), were both
  // invisible here. Those two are exactly what needs attention.
  //
  // ANDed with that: the source must still be enabled. A disabled source's
  // extraction status is a fact about the past — you switched the source off,
  // which is the user's own answer to whatever it was doing wrong, so keeping
  // it in a list titled `Needs attention` is nagging about a decision already
  // made. Its history is untouched and `All` still shows it.
  "views": [
    { "id": "all", "name": "All", "view": { "type": "list" } },
    {
      "id": "needs-attention",
      "name": "Needs attention",
      "view": {
        "type": "list",
        "filter": {
          "kind": "group",
          "id": "f-unhealthy",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-extraction-unhealthy",
              "fieldId": "extraction",
              "operatorId": "is-any-of",
              "value": ["failed", "empty"]
            },
            {
              "kind": "rule",
              "id": "r-enabled",
              "fieldId": "enabled",
              "operatorId": "is",
              "value": true
            }
          ]
        }
      }
    },
    {
      "id": "by-type",
      "name": "By type",
      "view": { "type": "list", "groupBy": "type" }
    }
  ],

  // A custom column, promoted here from a personal override so it is a shipped
  // default rather than one machine's private state. Its `id` is the join key to
  // the per-row values in `data_view_custom_values`, and each option's `value` is
  // what a row actually stores — so BOTH are durable external keys. Never re-mint
  // them to tidy them up: a new id orphans every categorised source, and a new
  // option value orphans every row holding the old one. The labels are free to
  // change; the ids are not.
  //
  // A source's category is a fact about the source that no upstream field
  // carries — the site does not publish "this is a dance school" — so it is
  // exactly what a custom column is for: a dimension the user owns, and (like
  // every field) a full filter / sort / group-by dimension on this DataView.
  "customColumns": [
    {
      "id": "cc-34277e80-5dc0-407e-9640-3e371a70a4ca",
      "label": "Category",
      "type": "enum",
      "config": {
        "options": [
          { "value": "05f4a68e-d5f6-4f7d-ae89-16a8afc8a498", "label": "Culture" },
          { "value": "29e1c644-a493-4af4-b6ac-148e7e827be3", "label": "Danse" },
          { "value": "832dfa9e-0029-4641-94bd-40a6cda4e768", "label": "Party" },
          { "value": "5a6a8237-f264-4557-b668-1fb8425aa1c6", "label": "Social" },
          { "value": "3070084c-36f7-4005-8bb1-6080b6d513af", "label": "Music" }
        ]
      }
    }
  ]
}
