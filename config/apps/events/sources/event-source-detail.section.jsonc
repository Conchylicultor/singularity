// @hash 17540b957d8a
// The source pane, read top to bottom: is it healthy, what is it pointed at,
// when does it run, what has it actually done.
//
//   status   — one collapsed bar carrying the state chip; it qualifies
//              everything below it, so it leads (the deploy server pane's
//              ordering, for the same reason).
//   settings — the type's own configuration. Absent entirely for a zero-config
//              type, which is why it cannot be the anchor row.
//   schedule — cadence, scheduling on/off, and Refresh now.
//   runs     — the ledger, and the longest card; it answers "why did nothing
//              happen", which is the question you ask AFTER checking the three
//              above, so it reads last.
//
// Registration order is filesystem-alphabetical (runs, schedule, settings,
// status), which is why this file is not just the seeded default.
{
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  "items": [
    "apps.events.sources.source-detail.status:status",
    "apps.events.sources.source-detail.settings:settings",
    "apps.events.sources.source-detail.schedule:schedule",
    "apps.events.sources.source-detail.runs:runs"
  ]
}
