// @hash 1539a4e88135
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
// The run pane's regions, below the run summary the pane renders itself.
//
//   model-call — the prompt the run sent and what came back. The reason the
//                pane exists: the summary answers "what happened", this
//                answers "why".
//   extracted-events — which events the run actually touched, and what it did
//                to each. Directly under the summary it explains: the counts
//                there raise the question this answers.
//   caveats    — what the extraction could not express. Below model-call: it
//                is a footnote on the extraction, read after the extraction
//                itself, and it is silent on a healthy run.
//
// A source type that records something else about its runs contributes a peer
// section and lands here.
{
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  "items": [
    "apps.events.sources.source-detail.runs.extracted-events:extracted-events",
    "apps.events.sources.source-detail.runs.model-call:model-call",
    "apps.events.sources.source-detail.runs.caveats:caveats"
  ]
}
