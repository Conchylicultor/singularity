// @hash bb17f187c7fb
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // Node forms: "pluginId:id" | { "item": "pluginId:id", "hidden": true } |
  // { "type": "spacer", "id": "<unique-id>" }.
  //
  // The `source` dimension is owned by the sources plugin (only it holds the
  // live `event_sources` rows its option list is built from). Contributed
  // fields land after this plugin's own schema, so `source` reads as the last
  // column — acceptable while it is the only extension; put a future
  // provenance-adjacent field beside it rather than at the far right.
  "items": ["apps.events.sources.source-field:source"]
}
