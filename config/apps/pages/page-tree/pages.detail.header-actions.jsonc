// @hash faa6cbbb1783
{
  // Hide: { "item": "<key>", "hidden": true }. Gap: { "type": "spacer", "id": "<unique-id>" }.
  //
  // Star and history act on the page's CONTENT; expand acts on the pane itself
  // (which surface you are reading it in). So expand sits last — the far corner,
  // where a title bar's own maximize control lives — and the content actions
  // keep their established order beside the title.
  "items": [
    "apps.pages.starred:star",
    "apps.pages.history:history",
    "apps.pages.open-in-app:open-in-app"
  ]
}
