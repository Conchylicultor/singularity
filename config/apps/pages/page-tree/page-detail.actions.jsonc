// @hash 6f0c711be052
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // A horizontal strip read left to right. The page's title (the breadcrumb)
  // leads, with Copy block ID right beside it — it copies the id of the page
  // the title names, the handle an agent's page tools take. The spacer then
  // pushes everything ABOUT the page to the far end: "Edited 2h ago" first — a
  // quiet fact you read, not a control — then the kind pill (a state you read
  // at a glance, tinted on an agent page, and a rare switch to flip), Star,
  // and History, a rarer, heavier affordance. No authored `⋯` bucket: the bar
  // still relocates whatever does not fit behind its own `⋯` when the pane is
  // narrow. The pane's own Expand and Close sit beyond these, painted by the
  // pane chrome rather than this slot.
  "items": [
    "primitives.pane:title",
    "apps.pages.copy-id:copy-id",
    { "type": "spacer", "id": "page-actions" },
    "apps.pages.page-tree:edited",
    "apps.pages.page-author:page-author",
    "apps.pages.starred:star",
    "apps.pages.history:history"
  ]
}
