// @hash ed26d3665383
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  //
  // Field extensions folded into the pages-sidebar DataView schema, in fold order.
  // Both are filter-only dimensions — hidden from every view's body via each
  // view instance's `visibleFields`, so neither renders a chip on a row.
  //
  // `starred` is what the Favorites section filters on.
  // `origin` is what splits the page tree into the Private section and the
  // Scratch section holding pages an automated session created (each a
  // root-scoped filter on it).
  // It sorts after `starred` so the Filter pill lists the older dimension first.
  //
  // `tags` is each page's tags (by id, labelled by name): filter or group the
  // sidebar by tag. Listed last, the newest dimension.
  "items": [
    "apps.pages.starred:starred",
    "apps.pages.agent-origin:origin",
    "apps.pages.page-tags:tags"
  ]
}
