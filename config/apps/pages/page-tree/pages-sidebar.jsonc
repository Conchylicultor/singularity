// @hash 6ec84829688d
{
  // The Pages sidebar's sections. The surface renders with the DataView
  // `sections` chrome (`pages-sidebar.tsx`): EVERY view instance below is on
  // screen at once, stacked in this order, each under its own collapsible
  // header — there is no view switcher. A header's `+` offers the creators
  // whose `views` name it (only `pages`: "New page"), and its `⋯` holds that
  // view's search / filter / sort plus "Section settings" and "Add section".
  //
  // `visibleFields: ["title"]` on every view keeps the contributed `starred`
  // bool and `origin` enum pure FILTER dimensions: the default (absent) shows
  // every schema field, which would render a chip on every row. Filter/sort/
  // search always see the full schema.
  //
  // Favorites is a `list`, not a filtered `tree`: a starred page is shown on
  // its own, never with its unstarred ancestors. Its row order is owned by the
  // view instance (data-view/view-order), which is why `starred` needs no rank
  // column. `hideWhenEmpty`: nothing starred → no Favorites header at all.
  //
  // Private and Scratch partition the page tree by the contributed `origin`
  // enum (agent-origin): pages written by an automated session are `agent`,
  // everything else `user`. `filterScope: "roots"` tests the ROOTS only and
  // keeps each kept root's whole subtree, so a subtree is never split between
  // the two and neither pulls in the other's ancestors (the default `rows`
  // scope would keep a matching child's whole ancestor chain). Scratch is
  // `hideWhenEmpty`: it appears only while agent pages exist, which the 24h
  // agent-origin sweep moves to trash.
  //
  // Each view's `id` is authored explicitly (enforced by the
  // `config-stable-list-ids` check): view ids key `data_view_row_order`, so a
  // derived/auto id would shift on rename/edit and orphan the saved order. The
  // main tree keeps the id `pages` under its new name "Private" for exactly
  // that reason.
  "views": [
    {
      "id": "favorites",
      "name": "Favorites",
      "icon": "star",
      "view": {
        "type": "list",
        "visibleFields": ["title"],
        "hideWhenEmpty": true,
        "filter": {
          "kind": "group",
          "id": "fav",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "fav-starred",
              "fieldId": "starred",
              "operatorId": "is",
              "value": true
            }
          ]
        }
      }
    },
    {
      "id": "pages",
      "name": "Private",
      "icon": "lock",
      "view": {
        "type": "tree",
        "visibleFields": ["title"],
        "filterScope": "roots",
        "filter": {
          "kind": "group",
          "id": "private",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "private-origin",
              "fieldId": "origin",
              "operatorId": "is",
              "value": "user"
            }
          ]
        }
      }
    },
    {
      // The pages edited in the past week, most recent first: a flat `list`
      // (a page on its own, never with its ancestors) sorted on the `editedAt`
      // field — the page's edit time, its row and its content together, which
      // the Welcome page's Recent pages and the page header's "Edited" label
      // also read. A sort overrides the view's manual row order,
      // so this section is never drag-arranged. Scratch pages stay out (they
      // have their own section and expire in 24h). `hideWhenEmpty`: nothing
      // edited this week → no header.
      "id": "recent",
      "name": "Recent",
      "view": {
        "type": "list",
        "visibleFields": ["title"],
        "hideWhenEmpty": true,
        "sort": [{ "fieldId": "editedAt", "direction": "desc" }],
        "filter": {
          "kind": "group",
          "id": "recent",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "recent-edited",
              "fieldId": "editedAt",
              "operatorId": "is-within-past",
              "value": { "amount": 7, "unit": "day" }
            },
            {
              "kind": "rule",
              "id": "recent-origin",
              "fieldId": "origin",
              "operatorId": "is",
              "value": "user"
            }
          ]
        }
      }
    },
    {
      "id": "scratch",
      "name": "Scratch",
      "icon": "edit-note",
      "view": {
        "type": "tree",
        "visibleFields": ["title"],
        "filterScope": "roots",
        "hideWhenEmpty": true,
        "description": "Pages created by agent runs — moved to trash after 24h.",
        "filter": {
          "kind": "group",
          "id": "scratch",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "scratch-origin",
              "fieldId": "origin",
              "operatorId": "is",
              "value": "agent"
            }
          ]
        }
      }
    }
  ]
}
