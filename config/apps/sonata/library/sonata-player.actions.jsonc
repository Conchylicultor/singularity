// @hash f60169436a8c
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// The Sonata player's header, read left to right: identity and tools. Playback
// itself — play / pause, the time, the chord timeline, loop — is the transport
// strip below the header (`config/apps/sonata/player/transport.jsonc`), not
// this row.
//
// Leading: ← Library (the way out), then the song title, which is the pane's own
// title item and the row's give — it holds the slack and ellipsizes rather than
// pushing the tools out.
//
// After the spacer, the tools, each named for its role: time — how fast (the
// speed wheel) and the beat that goes with it (the metronome, whose popover
// shows the live tempo) — then pitch (transpose), then output (volume), then the
// view: its zoom (the spread wheel) and, far right after every tool, which view
// it is (the display switcher). The wheels and volume fold to icon + value at
// rest and open on hover, so the row stays short. There is no divider node for a
// row; the controls' own pill borders separate the wheels.
//
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  "items": [
    "apps.sonata.library:back",
    "primitives.pane:title",
    { "type": "spacer", "id": "spacer-1" },
    "apps.sonata.transport-bar:speed",
    "apps.sonata.audio.metronome:metronome",
    "apps.sonata.transpose:transpose",
    "apps.sonata.audio.engine:volume",
    "apps.sonata.piano-roll:spread",
    "apps.sonata.library:display-picker"
  ]
}
