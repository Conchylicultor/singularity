// @hash 6ec84829688d
{
  "views": [
    // The record: the three fields a human authors, plus the last run's outcome.
    {
      "id": "deployments",
      "name": "Deployments",
      "view": {
        "type": "list",
        "visibleFields": ["composition", "hostnames", "loopbackPort", "run"]
      }
    },
    // Everything, including the DERIVED install names (run user, install dir,
    // systemd unit, Caddy site). Kept as a second view rather than columns on the
    // first so the model is visible on demand without four read-only strings
    // crowding the row a person actually edits.
    {
      "id": "install",
      "name": "Install",
      "view": { "type": "table" }
    }
  ]
}
