// @hash 7e8ab76d342d
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // Row actions on a deployment, ordered by how far each one reaches:
  //
  //   serve  — look at the composition locally; the remote host is untouched
  //   deploy — the whole remote deploy as one run (converge → build unless the
  //            bundle is already cut from this HEAD → ship behind the health
  //            gate), the same `update` the pane's Deploy button runs
  //   delete — forget the deployment RECORD; the converged host is untouched
  //
  // So the reading order goes local → remote → destructive. No spacer: three
  // actions is short enough that a gap would be decoration rather than a
  // grouping the user can act on.
  "items": [
    "apps.deploy.local-serve:serve",
    "apps.deploy.deployments:deploy",
    "apps.deploy.deployments:delete"
  ]
}
