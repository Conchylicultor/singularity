// @hash cfd581d970d3
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms: "pluginId:id" (an item, terse) |
// { "item": "pluginId:id", "hidden": true } (drop it from the slot) |
// { "type": "spacer", "id": "<unique-id>" } (a blank gap).
// At most one spacer per slot.
{
  // Hide: { "item": "<key>", "hidden": true }. Gap: { "type": "spacer", "id": "<unique-id>" }.
  "items": [
    "apps-core.surface:placement-control",
    "apps.agent-manager.worktree-switcher:worktree-switcher",
    "improve:improve",
    "build:build",
    { "type": "spacer", "id": "spacer-1" },
    "shell.notifications:notifications",
    "infra.health:health-dot",
    { "item": "screenshot:screenshot", "hidden": true },
    { "item": "screenshot.draw-on-app:draw-on-app", "hidden": true },
    "improve.element-picker:element-picker",
    "fullscreen:fullscreen-toggle",
    "ui.theme-toggle:theme-light-dark",
    "ui.theme-engine.quick-theme:quick-theme",
    "reorder.edit-mode:reorder-pen"
  ]
}
