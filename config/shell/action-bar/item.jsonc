// @hash 0d675211e194
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  // Horizontal bar, read left → right. Light/dark used to sit just before the
  // palette button; it is now a switch INSIDE that popover, so the bar carries
  // one theming control instead of two answering the same question. The
  // surface mode, browser fullscreen and edit-layout controls live in the
  // bar's gear popover (the `view-option` slot), not here.
  "items": [
    "improve:improve",
    "build:build",
    { "type": "spacer", "id": "spacer-1" },
    "shell.notifications:notifications",
    { "item": "screenshot:screenshot", "hidden": true },
    { "item": "screenshot.draw-on-app:draw-on-app", "hidden": true },
    "improve.element-picker:element-picker",
    "ui.theme-engine.quick-theme:quick-theme"
  ]
}
