// @hash 229102bb7c88
{
  // The agent manager paints its own designed theme, `mist`, contributed by the
  // agent-manager shell (`plugins/apps/plugins/agent-manager/plugins/shell/web/internal/theme.ts`)
  // — never the desktop's runtime choice. A group `mist` does not mention
  // paints its schema defaults.
  //
  // `colorMode` is deliberately absent: light/dark is a single global setting
  // today (`COLOR_MODE_SCOPE_ID` in `theme-engine/web/use-color-mode.ts`), so a
  // value here would claim something that is not true.
  "theme": "mist"
}
