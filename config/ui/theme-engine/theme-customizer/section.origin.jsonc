// @hash 8e34e753582c
{
  // Item: "<key>" (terse; <key> is "<pluginId>:<id>")
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  // Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
  "items": [
    "ui.theme-engine.theme-gallery:themes",
    "ui.tokens.categorical:categorical",
    "ui.tokens.chart:chart",
    "ui.tokens.color-adjust:color-adjust",
    "ui.tokens.color-palette:color-palette",
    "ui.tokens.density:density",
    "ui.tokens.font-family:font-family",
    "ui.tokens.shadow:shadow",
    "ui.tokens.shape:shape",
    "ui.tokens.sidebar-metrics:sidebar-metrics",
    "ui.tokens.sidebar-palette:sidebar-palette",
    "ui.tokens.type-scale:type-scale",
    "ui.tweakcn.community-browser:import-by-url"
  ]
}
