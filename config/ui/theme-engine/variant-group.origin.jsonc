{
  // Item: "<key>" (terse; <key> is "<pluginId>:<id>")
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  // Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
  "items": [
    "apps-core.app-rail-framing:app-rail-framing",
    "apps-core.surface.floating:floating-titlebar",
    "ui.breadcrumb-separator:breadcrumb-separator",
    "ui.segmented-progress-bar:segmented-progress-bar",
    "ui.sidebar-framing:sidebar-framing",
    "ui.tab-bar.customizer:tab-bar",
    "ui.tree-disclosure:tree-disclosure"
  ]
}
