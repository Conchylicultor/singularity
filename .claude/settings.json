{
  "showThinkingSummaries": true,
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": ["mcp__equin__query_db", "Bash(rg:*)", "Bash(ls:*)"],
    "deny": ["EnterWorktree", "ExitWorktree"]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"continue\": false, \"stopReason\": \"Context window full — session stopped (auto-compaction disabled)\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|NotebookEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 || { echo 'guards: bun is not on PATH, so no PreToolUse guard can run; every tool call is blocked until it is (an agent pane puts the mise shims first: runtime-tmux agent-session-env.ts)' >&2; exit 2; }; bun \"$CLAUDE_PROJECT_DIR/plugins/framework/plugins/tooling/plugins/guards/bin/guard.ts\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/plugins/framework/plugins/tooling/plugins/guards/bin/stop-guard.ts\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/plugins/framework/plugins/tooling/plugins/guards/bin/stop-guard.ts\""
          }
        ]
      }
    ]
  }
}
