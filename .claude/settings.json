{
  "showThinkingSummaries": true,
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": ["mcp__singularity__query_db", "Bash(rg:*)", "Bash(ls:*)"],
    "deny": ["EnterWorktree", "ExitWorktree"]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"continue\": false, \"stopReason\": \"Context window full — session stopped (auto-compaction disabled)\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|NotebookEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/plugins/framework/plugins/tooling/plugins/guards/bin/guard.ts\""
          }
        ]
      }
    ]
  }
}
